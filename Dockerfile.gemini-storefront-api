# build: 2026-09-26a
# Gemini ADK storefront API — SFCC product search + in-memory cart + Gemini shopping agent.

FROM python:3.11-slim
WORKDIR /app

COPY . .

RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir google-adk

ENV PYTHONUNBUFFERED=1
EXPOSE 8000

CMD ["uvicorn", "gemini.api.storefront_main:app", "--app-dir", "examples", "--host", "0.0.0.0", "--port", "8000"]
