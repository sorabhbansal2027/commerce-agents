# Gemini × UCP + MCP Apps UI demo — Railway service.
#
# Runs the split-screen demo: Gemini chat (left) + MCP Apps product-grid iframe (right).
# At startup, fetches the product-grid HTML from the MCP server Railway service via
# STOREFRONT_MCP_URL; falls back to the local file if the MCP server is unreachable.
#
# Required env vars (set in Railway service settings):
#   GEMINI_API_KEY          Google AI Studio or Vertex AI key
#   UCP_BASE                URL of the storefront UCP service
#                           e.g. https://diligent-flow-production-afd7.up.railway.app
#   STOREFRONT_MCP_URL      URL of the MCP server Railway service + /mcp path
#                           e.g. https://<mcp-service>.up.railway.app/mcp
#
# Build:  docker build -f Dockerfile.gemini -t commerce-gemini-demo .
# Run:    docker run -p 8099:8099 \
#           -e GEMINI_API_KEY=... \
#           -e UCP_BASE=https://... \
#           -e STOREFRONT_MCP_URL=https://.../mcp \
#           commerce-gemini-demo

FROM python:3.11-slim

WORKDIR /app

COPY . .
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir "google-genai>=1.0"

# Railway injects PORT; bridge it to the env var the demo server reads.
CMD ["sh", "-c", \
     "GEMINI_UI_PORT=${PORT:-8099} \
      python3 scripts/gemini_mcp_ui_server.py"]
