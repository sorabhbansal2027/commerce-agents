# Custom LiteLLM image with commerce-agents config baked in.
# Build and push to Docker Hub (or any registry) so Railway can pull it.
#
# Build:  docker build -f embed/Dockerfile.litellm embed/ -t YOUR_HUB/litellm-commerce:latest
# Push:   docker push YOUR_HUB/litellm-commerce:latest
# Then use YOUR_HUB/litellm-commerce:latest as the Railway image.

FROM ghcr.io/berriai/litellm:main-stable
# Path is relative to repo root — no custom build context needed on Railway
COPY embed/litellm-config.yaml /app/config.yaml
# Without --config the image starts with no model mappings; --detailed_debug helps Railway logs
CMD ["--config", "/app/config.yaml", "--port", "4000", "--detailed_debug"]
