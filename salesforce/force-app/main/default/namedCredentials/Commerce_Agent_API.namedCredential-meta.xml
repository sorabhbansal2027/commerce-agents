<?xml version="1.0" encoding="UTF-8"?>
<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Commerce Agent API</label>
    <name>Commerce_Agent_API</name>
    <!--
        Endpoint is set per-environment via Setup > Named Credentials
        so the code never hard-codes a URL.
        Point to the Railway (or local) FastAPI base URL.
    -->
    <endpoint>https://commerce-api.example.com</endpoint>
    <principalType>NamedUser</principalType>
    <protocol>NoAuthentication</protocol>
    <allowMergeFieldsInBody>false</allowMergeFieldsInBody>
    <allowMergeFieldsInHeader>false</allowMergeFieldsInHeader>
    <generateAuthorizationHeader>false</generateAuthorizationHeader>
</NamedCredential>
