# Storefront MCP server — Railway service.
#
# Serves the MCP streamable-HTTP endpoint at /mcp (port $PORT).
# Uses the mock retail backend (no Salesforce credentials needed) so the
# product-grid HTML resource and shopping tools are fully self-contained.
#
# Required env vars (set in Railway service settings):
#   STOREFRONT_MCP_UNSAFE_ALLOW_NO_AUTH=1   allow external binding (no auth gateway)
#
# Optional:
#   STOREFRONT_MCP_USER_ID    demo user whose cart / memory the tools act on (default: demo-user)
#   STOREFRONT_MCP_SESSION_ID session id (default: managed-agent-demo)
#
# Build:  docker build -f Dockerfile.mcp -t commerce-mcp .
# Run:    docker run -p 8200:8200 -e STOREFRONT_MCP_UNSAFE_ALLOW_NO_AUTH=1 commerce-mcp

FROM python:3.11-slim

WORKDIR /app

COPY . .
RUN pip install --no-cache-dir -r requirements.txt

# Railway injects PORT; bridge it to the env var the MCP server reads.
# STOREFRONT_MCP_HOST must be 0.0.0.0 so Railway's proxy can reach the container.
CMD ["sh", "-c", \
     "STOREFRONT_MCP_HOST=0.0.0.0 STOREFRONT_MCP_PORT=${PORT:-8200} \
      python3 shopping-agent/managed-agents/storefront-mcp-server/storefront_mcp_server.py"]
