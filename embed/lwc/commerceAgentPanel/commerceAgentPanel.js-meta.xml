<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <targets>
        <!-- Add to any OMS Lightning page from App Builder -->
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__RecordPage,lightning__HomePage">
            <property name="apiUrl"      type="String"  label="API root URL"
                      description="Commerce agent FastAPI root, e.g. https://commerce-api.example.com"/>
            <property name="apiPrefix"   type="String"  label="API prefix"
                      default="/api/merchant"
                      description="Route prefix for the merchant agent"/>
            <property name="panelTitle"  type="String"  label="Panel title"
                      default="Merchant assistant"/>
            <property name="introText"   type="String"  label="Empty-state intro"
                      default="Ask about performance, inventory, pricing, or campaigns."/>
            <property name="placeholder" type="String"  label="Composer placeholder"
                      default="Ask about sales, stock, pricing…"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
