<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__RecordPage,lightning__HomePage,lightningCommunity__Default">
            <property name="apiUrl"
                      type="String"
                      label="API Base URL"
                      description="Base URL of the Railway-hosted backend (e.g. https://your-app.up.railway.app)."/>
            <property name="apiPrefix"
                      type="String"
                      label="API Path Prefix"
                      default="/api"/>
            <property name="assistantName"
                      type="String"
                      label="Assistant Name"
                      default="Shopping Assistant"/>
            <property name="brandName"
                      type="String"
                      label="Brand Name"
                      default="ACME Store"/>
            <property name="placeholder"
                      type="String"
                      label="Input Placeholder"
                      default="Ask about a product, an order, or anything in the store…"/>
            <property name="introText"
                      type="String"
                      label="Intro Text"
                      default="Your AI shopping assistant. Ask about products, orders, returns, or recommendations."/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
